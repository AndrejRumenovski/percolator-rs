# Recorded reference numbers + budgets for the CI regression gate.
# percolator-rs is seed-deterministic, so fixture yields are exact; we assert +/-1%.
# Fixture: tests/fixtures/sample.pin (12000 PSMs, canonical profile, --seed 1).
#
# Re-recorded after the 2026-08 statistical repair (finite-sample target-decoy
# safeguard, tie grouping, fold-local preprocessing and score scaling,
# spectrum-grouped folds, spectrum-level competition). These are the yields of the
# corrected method; the pre-repair numbers below are kept for the record and are
# NOT an acceptance criterion, because the methodology that produced them failed
# scientific validation.
#
#   pre-repair (historical):  fixture 132 PSM / 38 peptide ; full 107046 / 37469
#
# Peptide yield is asserted at q<0.05 rather than q<0.01. On a fixture this small
# the corrected estimator's best achievable statement is 1/38 = 0.026, so a q<0.01
# peptide gate would assert 0 and pass for any broken build.

FIXTURE_PSM_Q01=117
FIXTURE_PEP_Q05=43
YIELD_TOLERANCE_PCT=1        # allowed drift vs recorded, percent

# Budgets (generous vs the ~0.06s/14MB local run, to absorb slow CI runners).
FIXTURE_TIME_BUDGET_S=30
FIXTURE_MEM_BUDGET_KB=524288   # 512 MiB

# --- Full-dataset gate (bench/regression.sh; needs the PXD032157 data, not in CI) ---
# Canonical profile, N=4 file-level concurrency. Measured 18.2s / 750 MiB.
FULL_PSM_Q01=106795
FULL_PEP_Q01=35866
FULL_TIME_BUDGET_S=45
FULL_MEM_BUDGET_KB=1572864     # 1.5 GiB
